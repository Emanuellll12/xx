// ==================== IMPRESSÃO VIA BRIDGE ANDROID ====================
// window.AndroidPrinter é injetado pelo APK (JavascriptInterface)
function imprimirCupom(itens, total, codigoVenda, metodoPagamento) {
    try {
        const agora = new Date();
        const data = agora.toLocaleDateString('pt-BR');
        const hora = agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const codFormatado = '#' + String(codigoVenda).slice(-6).padStart(6, '0');

        // Monta linhas do cupom como JSON para o Android processar
        const cupom = {
            loja: 'CASA DO SALGADO',
            codigo: codFormatado,
            data: data,
            hora: hora,
            metodo: metodoPagamento,
            itens: itens.map(i => ({
                nome: i.nome,
                qtd: i.quantidade,
                preco: parseFloat(i.preco).toFixed(2),
                subtotal: (parseFloat(i.preco) * i.quantidade).toFixed(2)
            })),
            total: total.toFixed(2)
        };

        if (window.AndroidPrinter) {
            window.AndroidPrinter.imprimir(JSON.stringify(cupom));
            console.log('Cupom enviado para impressora Android');
        } else {
            console.log('AndroidPrinter não disponível (modo browser)');
        }
    } catch(e) {
        console.error('Erro ao imprimir cupom:', e);
    }
}

// ==================== INICIALIZAÇÃO ====================
document.addEventListener('DOMContentLoaded', async () => {
    await supabaseClient.auth.signOut();
    document.getElementById('telaLogin').classList.add('active');
});

// ==================== AUTENTICAÇÃO ====================
async function fazerLogin() {
    const email = document.getElementById('loginEmail').value.trim();
    const senha = document.getElementById('loginSenha').value;
    const erroEl = document.getElementById('loginErro');
    erroEl.style.display = 'none';
    if (!email || !senha) { erroEl.textContent = 'Preencha e-mail e senha'; erroEl.style.display = 'block'; return; }
    try {
        const { data: loginData, error: loginError } = await supabaseClient.auth.signInWithPassword({ email, password: senha });
        if (loginError || !loginData?.user) { erroEl.textContent = 'E-mail ou senha incorretos'; erroEl.style.display = 'block'; return; }
        usuarioAtual = loginData.user;
        const { data: usuariosLoja, error: erroUsu } = await supabaseClient.from('usuarios_loja').select('loja_id, cargo').eq('user_id', usuarioAtual.id).limit(1);
        if (erroUsu || !usuariosLoja || usuariosLoja.length === 0) { erroEl.textContent = 'Usuário sem loja associada'; erroEl.style.display = 'block'; return; }
        const loja_id = usuariosLoja[0].loja_id;
        const { data: lojaInfo, error: erroLoja } = await supabaseClient.from('lojas').select('*').eq('id', loja_id).maybeSingle();
        if (erroLoja || !lojaInfo) { erroEl.textContent = 'Loja não encontrada'; erroEl.style.display = 'block'; return; }
        if (lojaInfo.status !== 'ATIVO') { erroEl.textContent = 'Loja inativa. Contate o suporte.'; erroEl.style.display = 'block'; return; }
        lojaAtual = lojaInfo;
        document.getElementById('telaLogin').classList.remove('active');
        await verificarOuCriarCaixa();
        carregarProdutos();
    } catch(e) {
        console.error('Erro login:', e);
        erroEl.textContent = 'Erro ao fazer login: ' + e.message;
        erroEl.style.display = 'block';
    }
}

async function verificarOuCriarCaixa() {
    try {
        const { data } = await supabaseClient.from('caixas').select('*').eq('loja_id', lojaAtual.id).eq('status', 'ABERTO').order('data_abertura', { ascending: false }).limit(1).maybeSingle();
        if (data) { caixaAtual = data; }
        else {
            const { data: novoCaixa, error: erroCaixa } = await supabaseClient.from('caixas').insert([{ loja_id: lojaAtual.id, usuario_abertura: usuarioAtual.id, valor_inicial: 0, observacao_abertura: 'Caixa aberto automaticamente pelo Totem', status: 'ABERTO' }]).select().maybeSingle();
            if (erroCaixa) { console.error('Erro ao criar caixa:', erroCaixa); return; }
            caixaAtual = novoCaixa;
        }
    } catch(e) { console.error('Erro ao verificar caixa:', e); }
}

async function carregarProdutos() {
    try {
        const { data, error } = await supabaseClient.from('itens').select('codigo, nome, categoria, preco_venda, estoque, unidade, loja_id, foto_url').eq('ativo', true).eq('loja_id', lojaAtual.id).gt('estoque', 0).order('nome');
        if (error) throw error;
        produtosTodos = data || [];
        renderizarSidebar(produtosTodos);
        mostrarTelaBoasVindas();
    } catch(e) {
        console.error('Erro ao carregar produtos:', e);
        document.getElementById('produtosGrid').innerHTML = '<div class="loading-state"><p>⚠️ Erro ao carregar cardápio</p></div>';
    }
}

const CATEGORIAS_IMAGENS = {
    'Sorvetes': 'https://images.unsplash.com/photo-1497034825429-c343d7c6a68f?w=400&q=80',
    'Salgados': 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&q=80',
    'Bebidas':  'https://images.unsplash.com/photo-1544145945-f90425340c7e?w=400&q=80',
    'Combos':   'https://images.unsplash.com/photo-1606755962773-d324e0a13086?w=400&q=80',
    'Outros':   'https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?w=400&q=80',
};

function mostrarTelaBoasVindas() {
    const container = document.getElementById('bvParticles');
    container.innerHTML = '';
    for (let i = 0; i < 18; i++) {
        const p = document.createElement('div');
        p.className = 'bv-particle';
        const size = Math.random() * 80 + 20;
        p.style.cssText = `width:${size}px;height:${size}px;left:${Math.random()*100}%;animation-duration:${Math.random()*12+8}s;animation-delay:${Math.random()*10}s;opacity:0;`;
        container.appendChild(p);
    }
    const grid = document.getElementById('bvGrid');
    grid.innerHTML = '';
    Object.entries(CATEGORIAS_CONFIG).forEach(([nome, cfg]) => {
        const count = produtosTodos.filter(cfg.filtro).length;
        if (count === 0) return;
        const imgUrl = CATEGORIAS_IMAGENS[nome];
        const card = document.createElement('div');
        card.className = 'bv-cat-card';
        card.innerHTML = `
            ${imgUrl
                ? `<img class="bv-cat-img" src="${imgUrl}" alt="${nome}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                   <div class="bv-cat-emoji" style="display:none">${cfg.icon}</div>`
                : `<div class="bv-cat-emoji">${cfg.icon}</div>`
            }
            <div class="bv-cat-overlay"></div>
            <div class="bv-cat-nome">${nome}</div>
        `;
        card.onclick = (e) => { e.stopPropagation(); irParaCategoria(nome); };
        grid.appendChild(card);
    });
    document.getElementById('telaBoasVindas').classList.add('active');
}

function irParaCategoria(nome) {
    document.getElementById('telaBoasVindas').classList.remove('active');
    selecionarCategoria(nome);
}

const CATEGORIAS_CONFIG = {
    'Sorvetes': { icon: '🍦', filtro: p => p.codigo.toUpperCase().startsWith('X') },
    'Salgados': { icon: '🍔', filtro: p => p.categoria === 'Salgados' && !p.codigo.toUpperCase().startsWith('X') },
    'Bebidas':  { icon: '🥤', filtro: p => p.categoria === 'Bebidas' && !p.codigo.toUpperCase().startsWith('X') },
    'Combos':   { icon: '🍟', filtro: p => p.categoria === 'Combos' && !p.codigo.toUpperCase().startsWith('X') },
    'Outros':   { icon: '🍰', filtro: p => p.categoria === 'Outros' && !p.codigo.toUpperCase().startsWith('X') },
};

function renderizarSidebar(produtos) {
    const sidebar = document.getElementById('sidebarCats');
    sidebar.innerHTML = '';
    let primeiraCategoria = null;
    Object.entries(CATEGORIAS_CONFIG).forEach(([nome, cfg]) => {
        const count = produtos.filter(cfg.filtro).length;
        if (count === 0) return;
        if (!primeiraCategoria) primeiraCategoria = nome;
        const btn = document.createElement('button');
        btn.className = 'cat-btn';
        btn.dataset.cat = nome;
        btn.innerHTML = `<span class="cat-icon">${cfg.icon}</span><span>${nome.toUpperCase()}</span>`;
        btn.onclick = () => selecionarCategoria(nome);
        sidebar.appendChild(btn);
    });
    if (primeiraCategoria) selecionarCategoria(primeiraCategoria);
}

function selecionarCategoria(nome) {
    categoriaAtiva = nome;
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector(`[data-cat="${nome}"]`);
    if (btn) btn.classList.add('active');
    document.getElementById('categoriaTitulo').textContent = nome.toUpperCase();
    const cfg = CATEGORIAS_CONFIG[nome];
    const produtos = produtosTodos.filter(cfg.filtro);
    renderizarProdutos(produtos);
}

function renderizarProdutos(produtos) {
    const grid = document.getElementById('produtosGrid');
    if (produtos.length === 0) { grid.innerHTML = '<div class="loading-state"><p>📦 Nenhum produto disponível</p></div>'; return; }
    window.produtosRenderizados = [];
    grid.innerHTML = produtos.map((p, index) => {
        const temFoto = p.foto_url && p.foto_url.trim() !== '';
        window.produtosRenderizados[index] = p;
        return `
        <div class="produto-card" onclick="adicionarPorIndex(${index})">
            <div class="produto-img-wrapper">
                ${temFoto
                    ? `<img src="${p.foto_url}" alt="${escapeHtml(p.nome)}" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"><span class="produto-img-placeholder" style="display:none;">${getCategoriaEmoji(p.categoria, p.codigo)}</span>`
                    : `<span class="produto-img-placeholder">${getCategoriaEmoji(p.categoria, p.codigo)}</span>`
                }
            </div>
            <div class="produto-info">
                <div class="produto-nome-card">${escapeHtml(p.nome)}</div>
                <div class="produto-preco-card">R$ ${parseFloat(p.preco_venda).toFixed(2).replace('.', ',')}</div>
                <button class="btn-adicionar-card" onclick="event.stopPropagation(); adicionarPorIndex(${index})">ADICIONAR</button>
            </div>
        </div>`;
    }).join('');
}

function adicionarPorIndex(index) {
    if (!window.produtosRenderizados) { mostrarToast('❌ Erro ao adicionar produto'); return; }
    const produto = window.produtosRenderizados[index];
    if (produto) adicionarAoCarrinhoTotem(produto);
    else mostrarToast('❌ Produto não encontrado');
}

function getCategoriaEmoji(cat, codigo) {
    if (codigo && codigo.toUpperCase().startsWith('X')) return '🍦';
    const map = { 'Salgados': '🍔', 'Bebidas': '🥤', 'Combos': '🍟', 'Outros': '🍰', 'Sorvetes': '🍦' };
    return map[cat] || '🍽️';
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function adicionarAoCarrinhoTotem(produto) {
    const existente = carrinho.find(i => i.codigo === produto.codigo);
    if (existente) {
        if (existente.quantidade >= produto.estoque) { mostrarToast('⚠️ Estoque esgotado!'); return; }
        existente.quantidade++;
    } else {
        carrinho.push({ codigo: produto.codigo, nome: produto.nome, preco: produto.preco_venda, quantidade: 1, estoque: produto.estoque });
    }
    atualizarFooterCarrinho();
    mostrarToast(`✅ ${produto.nome} adicionado!`);
    const btns = document.querySelectorAll('.btn-adicionar-card');
    btns.forEach(b => {
        if (b.closest('.produto-card')?.querySelector('.produto-nome-card')?.textContent === produto.nome) {
            b.classList.add('added'); b.textContent = '✓ ADICIONADO';
            setTimeout(() => { b.classList.remove('added'); b.textContent = 'ADICIONAR'; }, 1200);
        }
    });
}

function atualizarFooterCarrinho() {
    const total = carrinho.reduce((s, i) => s + (parseFloat(i.preco) * i.quantidade), 0);
    const qtd = carrinho.reduce((s, i) => s + i.quantidade, 0);
    document.getElementById('carrinhoValorFooter').textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
    const badge = document.getElementById('carrinhoQtdBadge');
    if (qtd > 0) { badge.style.display = 'flex'; badge.textContent = qtd; badge.style.position = 'absolute'; }
    else { badge.style.display = 'none'; }
    document.getElementById('btnConfirmar').disabled = qtd === 0;
}

function getValorTotal() {
    return carrinho.reduce((s, i) => s + (parseFloat(i.preco) * i.quantidade), 0);
}

function abrirCarrinho() {
    if (carrinho.length === 0) return;
    renderizarModalCarrinho();
    document.getElementById('modalCarrinho').classList.add('active');
}

function fecharCarrinho() { document.getElementById('modalCarrinho').classList.remove('active'); }

function renderizarModalCarrinho() {
    const body = document.getElementById('modalCarrinhoBody');
    const totalEl = document.getElementById('totalModal');
    if (carrinho.length === 0) { body.innerHTML = `<div class="empty-carrinho"><div class="empty-carrinho-icon">🛒</div><p>Carrinho vazio</p></div>`; totalEl.textContent = 'R$ 0,00'; return; }
    body.innerHTML = carrinho.map((item, idx) => `
        <div class="carrinho-item">
            <div class="item-info">
                <div class="item-nome-cart">${escapeHtml(item.nome)}</div>
                <div class="item-preco-unit">R$ ${parseFloat(item.preco).toFixed(2).replace('.', ',')} cada</div>
            </div>
            <div class="qtd-ctrl">
                <button onclick="alterarQtdCarrinho(${idx}, -1)">−</button>
                <span>${item.quantidade}</span>
                <button onclick="alterarQtdCarrinho(${idx}, 1)">+</button>
            </div>
            <div class="item-subtotal">R$ ${(parseFloat(item.preco) * item.quantidade).toFixed(2).replace('.', ',')}</div>
        </div>
    `).join('');
    totalEl.textContent = `R$ ${getValorTotal().toFixed(2).replace('.', ',')}`;
}

function alterarQtdCarrinho(idx, delta) {
    const item = carrinho[idx];
    const nova = item.quantidade + delta;
    if (nova <= 0) { carrinho.splice(idx, 1); }
    else if (nova > item.estoque) { mostrarToast('⚠️ Estoque esgotado!'); return; }
    else { item.quantidade = nova; }
    atualizarFooterCarrinho();
    renderizarModalCarrinho();
    if (carrinho.length === 0) fecharCarrinho();
}

async function sendPost(rota, body) {
    try {
        const responseData = await fetch(BASE_URL + rota, {
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
            method: 'POST',
            body: JSON.stringify(body)
        });
        const data = await responseData.json();
        console.log('TEF response:', data);
        return data;
    } catch (err) {
        console.error('TEF error:', err);
        return null;
    }
}

// Extrai o objeto resultado independente se vem em data.resultado ou data.dados.resultado
function extrairResultado(venda) {
    if (!venda) return null;
    // Estrutura nova: { dados: { resultado: { ... } } }
    if (venda.dados && venda.dados.resultado) return venda.dados.resultado;
    // Estrutura antiga: { resultado: { ... } }
    if (venda.resultado && typeof venda.resultado === 'object') return venda.resultado;
    // resultado como string JSON
    if (venda.resultado && typeof venda.resultado === 'string' && venda.resultado.includes('{')) {
        try { return JSON.parse(venda.resultado); } catch(e) {}
    }
    return null;
}

function tefAprovado(venda) {
    if (!venda) return false;
    const r = extrairResultado(venda);
    console.log('[TEF] extrairResultado =>', JSON.stringify(r));
    if (!r) { console.log('[TEF] resultado nulo'); return false; }

    // Estrutura nova Elgin: dados.resultado.mensagem === "Sucesso" e codigo === 0
    const codigoNum = Number(r.codigo);
    const msg = String(r.mensagem || '').trim();
    console.log('[TEF] mensagem=' + msg + ' codigo=' + codigoNum);

    if (msg === 'Sucesso' && codigoNum === 0) {
        console.log('[TEF] APROVADO via Sucesso/0');
        return true;
    }
    // Estrutura antiga: tef.mensagemResultado
    if (r.tef && r.tef.mensagemResultado === 'TRANSAC APROVADA') {
        console.log('[TEF] APROVADO via TRANSAC APROVADA');
        return true;
    }
    console.log('[TEF] NAO APROVADO - msg=' + msg + ' codigo=' + codigoNum);
    return false;
}

// Envia confirmação quando requer_confirmacao=1
async function tefConfirmar(venda, confirmado) {
    try {
        const r = extrairResultado(venda);
        if (!r || r.requer_confirmacao !== "1") return; // não precisa confirmar
        const acao = confirmado ? "confirmar" : "desfazer";
        console.log('TEF confirmação:', acao);
        await sendPost('/confirmar', { acao });
    } catch(e) {
        console.error('Erro ao confirmar TEF:', e);
    }
}

async function tefPix(valor) {
    const v = await sendPost('/pix', { valor });
    if (!v) return null;
    if (tefAprovado(v)) { historicoVendas.push(v); await tefConfirmar(v, true); }
    else { await tefConfirmar(v, false); }
    return v;
}

