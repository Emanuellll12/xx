async function iniciarPagamento(metodo) {
    fecharCarrinho();
    const iconMap  = { 'PIX': '📱', 'CREDITO': '💳', 'DEBITO': '💳' };
    const nomeMap  = { 'PIX': 'PIX', 'CREDITO': 'CARTÃO DE CRÉDITO', 'DEBITO': 'CARTÃO DE DÉBITO' };
    const valor = getValorTotal().toFixed(2);
    document.getElementById('pgtoIcone').textContent = iconMap[metodo];
    document.getElementById('pgtoTitulo').textContent = nomeMap[metodo];
    document.getElementById('pgtoSubtitulo').textContent = 'Aproxime ou insira seu cartão no terminal';
    document.getElementById('pgtoValor').textContent = `R$ ${valor.replace('.', ',')}`;
    document.getElementById('pgtoStatus').innerHTML = '<p>🔄 Aguardando processamento no terminal...</p>';
    document.getElementById('btnCancelarPgto').disabled = false;
    document.getElementById('modalPagamento').classList.add('active');
    try {
        let resultado = null;
        if (metodo === 'PIX') resultado = await tefPix(valor);
        else if (metodo === 'CREDITO') resultado = await tefCredito(valor);
        else if (metodo === 'DEBITO') resultado = await tefDebito(valor);
        if (!resultado) {
            document.getElementById('pgtoStatus').innerHTML = '<p>❌ Terminal não respondeu. Verifique se o GP está ativo.</p>';
            document.getElementById('btnCancelarPgto').disabled = false;
            return;
        }
        if (tefAprovado(resultado)) {
            document.getElementById('pgtoStatus').innerHTML = '<p>✅ Pagamento aprovado!</p>';
            document.getElementById('btnCancelarPgto').disabled = true;
            const r = extrairResultado(resultado); const tef = (r && r.tef) ? r.tef : {};
            const dadosTEF = { nsu: tef.nsuTerminal || tef.nsuTransacao || null, data_tef: tef.dataHoraTransacao || null, autorizacao: tef.codigoAutorizacao || null, bandeira: tef.nomeBandeira || tef.codigoBandeira || null, parcelas: tef.parcelas || 1 };
            const reg = await registrarVendaTotem(metodo, dadosTEF);
            document.getElementById('modalPagamento').classList.remove('active');
            if (reg?.sucesso) {
                // ✅ IMPRIMIR CUPOM APÓS VENDA BEM-SUCEDIDA
                imprimirCupom(carrinho, getValorTotal(), reg.codigo_venda, metodo);
                mostrarSucesso(reg.codigo_venda);
            } else {
                alert('❌ Pagamento aprovado no TEF, mas erro ao salvar no sistema.\nNSU: ' + (dadosTEF.nsu || 'N/A'));
            }
        } else {
            const _r = extrairResultado(resultado); const msg = (_r && _r.tef && _r.tef.mensagemResultado) || (_r && _r.mensagem) || resultado?.mensagem || 'Transação não aprovada';
            document.getElementById('pgtoStatus').innerHTML = `<p>❌ ${msg}</p>`;
            document.getElementById('btnCancelarPgto').disabled = false;
        }
    } catch(e) {
        console.error('Erro pagamento:', e);
        document.getElementById('pgtoStatus').innerHTML = `<p>❌ Erro: ${e.message}</p>`;
        document.getElementById('btnCancelarPgto').disabled = false;
    }
}

function cancelarPagamento() { document.getElementById('modalPagamento').classList.remove('active'); abrirCarrinho(); }

let parcelasDivididas = [];
let contadorParcelas = 0;

function iniciarPagamentoDividido() {
    fecharCarrinho();
    parcelasDivididas = [];
    contadorParcelas = 0;
    const total = getValorTotal();
    document.getElementById('valorTotalDivididoLabel').textContent = `Total: R$ ${total.toFixed(2).replace('.', ',')}`;
    document.getElementById('resumoTotalDiv').textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
    adicionarParcelaDividida();
    document.getElementById('modalDividido').classList.add('active');
}

function fecharDividido() { document.getElementById('modalDividido').classList.remove('active'); abrirCarrinho(); }

function adicionarParcelaDividida() {
    if (parcelasDivididas.length >= 4) { mostrarToast('Máximo de 4 formas de pagamento'); return; }
    contadorParcelas++;
    parcelasDivididas.push({ id: contadorParcelas, metodo: 'DINHEIRO', valor: 0 });
    renderizarParcelasDivididas();
}

function removerParcelaDividida(id) { parcelasDivididas = parcelasDivididas.filter(p => p.id !== id); renderizarParcelasDivididas(); }

function atualizarParcelaDividida(id, campo, valor) {
    const p = parcelasDivididas.find(x => x.id === id);
    if (p) { p[campo] = valor; calcularResumoDividido(); }
}

function renderizarParcelasDivididas() {
    const lista = document.getElementById('listaPagamentosDivididos');
    lista.innerHTML = parcelasDivididas.map((p, idx) => `
        <div class="dividido-item">
            <div class="dividido-item-header">
                <span class="dividido-numero">Pagamento ${idx + 1}</span>
                ${parcelasDivididas.length > 1 ? `<button class="btn-rm-dividido" onclick="removerParcelaDividida(${p.id})">🗑️ Remover</button>` : ''}
            </div>
            <div class="dividido-row">
                <div class="form-group"><label>Forma</label>
                    <select onchange="atualizarParcelaDividida(${p.id}, 'metodo', this.value)">
                        <option value="DINHEIRO" ${p.metodo==='DINHEIRO'?'selected':''}>💵 Dinheiro</option>
                        <option value="PIX" ${p.metodo==='PIX'?'selected':''}>📱 PIX</option>
                        <option value="DEBITO" ${p.metodo==='DEBITO'?'selected':''}>💳 Débito</option>
                        <option value="CREDITO" ${p.metodo==='CREDITO'?'selected':''}>💳 Crédito</option>
                    </select>
                </div>
                <div class="form-group"><label>Valor (R$)</label>
                    <input type="number" step="0.01" min="0" value="${p.valor}" onchange="atualizarParcelaDividida(${p.id}, 'valor', parseFloat(this.value)||0)" placeholder="0,00">
                </div>
            </div>
        </div>
    `).join('');
    const btnAdd = document.getElementById('btnAddParcela');
    if (btnAdd) btnAdd.style.display = parcelasDivididas.length >= 4 ? 'none' : 'block';
    calcularResumoDividido();
}

function calcularResumoDividido() {
    const total = getValorTotal();
    const pago = parcelasDivididas.reduce((s, p) => s + (parseFloat(p.valor) || 0), 0);
    const restante = total - pago;
    document.getElementById('resumoPagoDiv').textContent = `R$ ${pago.toFixed(2).replace('.', ',')}`;
    const restEl = document.getElementById('resumoRestanteDiv');
    if (Math.abs(restante) < 0.01) { restEl.textContent = '✅ COMPLETO'; restEl.className = 'ok'; }
    else if (restante > 0) { restEl.textContent = `R$ ${restante.toFixed(2).replace('.', ',')}`;  restEl.className = 'faltante'; }
    else { restEl.textContent = `R$ ${Math.abs(restante).toFixed(2).replace('.', ',')} excedente`; restEl.className = 'faltante'; }
}

async function finalizarDividido() {
    const total = getValorTotal();
    const pago = parcelasDivididas.reduce((s, p) => s + (parseFloat(p.valor) || 0), 0);
    if (Math.abs(total - pago) > 0.01) { mostrarToast('⚠️ O valor pago não bate com o total!'); return; }
    document.getElementById('modalDividido').classList.remove('active');
    // Salva carrinho antes de processar (será usado na impressão)
    const carrinhoParaImprimir = [...carrinho];
    const totalParaImprimir = getValorTotal();

    for (let i = 0; i < parcelasDivididas.length; i++) {
        const parcela = parcelasDivididas[i];
        const valor = parseFloat(parcela.valor).toFixed(2);
        document.getElementById('pgtoIcone').textContent = parcela.metodo === 'PIX' ? '📱' : parcela.metodo === 'DINHEIRO' ? '💵' : '💳';
        document.getElementById('pgtoTitulo').textContent = `PAGAMENTO ${i + 1}/${parcelasDivididas.length}`;
        document.getElementById('pgtoSubtitulo').textContent = `${parcela.metodo} — R$ ${valor.replace('.', ',')}`;
        document.getElementById('pgtoValor').textContent = `R$ ${valor.replace('.', ',')}`;
        document.getElementById('pgtoStatus').innerHTML = '<p>🔄 Aguardando terminal...</p>';
        document.getElementById('btnCancelarPgto').disabled = true;
        document.getElementById('modalPagamento').classList.add('active');
        try {
            if (parcela.metodo === 'DINHEIRO') {
                document.getElementById('pgtoStatus').innerHTML = `<p>✅ Pagamento ${i + 1} aprovado!</p>`;
                await new Promise(r => setTimeout(r, 600));
                continue;
            }
            let resultado = null;
            if (parcela.metodo === 'PIX') resultado = await tefPix(valor);
            else if (parcela.metodo === 'CREDITO') resultado = await tefCredito(valor);
            else if (parcela.metodo === 'DEBITO') resultado = await tefDebito(valor);
            if (!tefAprovado(resultado)) {
                const _r = extrairResultado(resultado); const msg = (_r && _r.tef && _r.tef.mensagemResultado) || (_r && _r.mensagem) || resultado?.mensagem || 'Transação não aprovada';
                document.getElementById('pgtoStatus').innerHTML = `<p>❌ ${msg}</p>`;
                await new Promise(r => setTimeout(r, 2500));
                document.getElementById('modalPagamento').classList.remove('active');
                mostrarToast('❌ ' + msg + '. Tente novamente.');
                abrirCarrinho();
                return;
            }
            document.getElementById('pgtoStatus').innerHTML = `<p>✅ Pagamento ${i + 1} aprovado!</p>`;
            await new Promise(r => setTimeout(r, 800));
        } catch(e) {
            document.getElementById('pgtoStatus').innerHTML = `<p>❌ Erro: ${e.message}</p>`;
            await new Promise(r => setTimeout(r, 2500));
            document.getElementById('modalPagamento').classList.remove('active');
            mostrarToast('❌ Erro no pagamento');
            abrirCarrinho();
            return;
        }
    }
    document.getElementById('modalPagamento').classList.remove('active');
    const reg = await registrarVendaTotem('DIVIDIDO', {});
    if (reg?.sucesso) {
        // ✅ IMPRIMIR CUPOM DIVIDIDO
        imprimirCupom(carrinhoParaImprimir, totalParaImprimir, reg.codigo_venda, 'DIVIDIDO');
        mostrarSucesso(reg.codigo_venda);
    } else {
        alert('❌ Todos os pagamentos aprovados, mas erro ao salvar no sistema. Contate o suporte.');
    }
}

async function registrarVendaTotem(tipoPagamento, dadosTEF) {
    if (carrinho.length === 0) return { sucesso: false };
    try {
        const valorTotal = getValorTotal();
        const qtdItens = carrinho.reduce((s, i) => s + i.quantidade, 0);
        const { data: vendaRegistrada, error: vendaError } = await supabaseClient.from('vendas').insert([{
            loja_id: lojaAtual.id, valor_total: valorTotal, metodo_pagamento: tipoPagamento,
            quantidade_itens: qtdItens, status: 'CONCLUIDA', usuario: usuarioAtual.email,
            nsu_tef: dadosTEF?.nsu || null, chave_tef: dadosTEF?.chave || null,
            observacao: `Venda via Totem - ${tipoPagamento} - Loja: ${lojaAtual.nome}`
        }]).select().maybeSingle();
        if (vendaError) throw vendaError;
        if (!vendaRegistrada) throw new Error('Venda não registrada');
        const itensVenda = carrinho.map(item => ({ venda_id: vendaRegistrada.id, codigo_produto: item.codigo, nome_produto: item.nome, quantidade: item.quantidade, preco_unitario: parseFloat(item.preco), subtotal: parseFloat(item.preco) * item.quantidade }));
        await supabaseClient.from('itens_venda').insert(itensVenda);
        for (const item of carrinho) {
            const { data: itemAtual } = await supabaseClient.from('itens').select('estoque').eq('codigo', item.codigo).eq('loja_id', lojaAtual.id).maybeSingle();
            if (itemAtual) await supabaseClient.from('itens').update({ estoque: Math.max(0, itemAtual.estoque - item.quantidade) }).eq('codigo', item.codigo).eq('loja_id', lojaAtual.id);
            await supabaseClient.from('movimentacoes').insert([{ item_codigo: item.codigo, tipo: 'VENDA', quantidade: -item.quantidade, valor_unitario: item.preco, responsavel: usuarioAtual.email, observacao: `Venda Totem #${vendaRegistrada.id} - ${tipoPagamento}` }]);
        }
        const sorvetes = carrinho.filter(i => String(i.codigo).toUpperCase().startsWith('X'));
        if (sorvetes.length > 0) notificarVendaSorveteTotem(carrinho, vendaRegistrada.id, valorTotal).catch(console.error);
        return { sucesso: true, codigo_venda: vendaRegistrada.id };
    } catch(e) {
        console.error('Erro registro venda:', e);
        return { sucesso: false, erro: e.message };
    }
}

