            const valorTotal = parseFloat(getValorTotal());
            
            console.log('Iniciando pagamento em DINHEIRO...');
            
            // Pedir valor recebido
            const valorRecebidoStr = prompt(`💵 PAGAMENTO EM DINHEIRO\n\nValor da compra: R$ ${valorTotal.toFixed(2)}\n\nDigite o valor recebido:`);
            
            if (valorRecebidoStr === null) return; // Cancelou
            
            const valorRecebido = parseFloat(valorRecebidoStr.replace(',', '.'));
            
            if (isNaN(valorRecebido) || valorRecebido < valorTotal) {
                alert('❌ Valor inválido ou insuficiente!');
                return;
            }
            
            const troco = valorRecebido - valorTotal;
            
            try {
                // 1. TENTAR ABRIR GAVETA DE DINHEIRO
                console.log('Abrindo gaveta de dinheiro...');
                const resultadoGaveta = await abrirGaveta();
                
                // Verificar se gaveta abriu ou se usuário quer continuar sem ela
                if (resultadoGaveta && !resultadoGaveta.sucesso && !resultadoGaveta.continuarVenda) {
                    console.log('❌ Venda cancelada pelo usuário (gaveta não abriu)');
                    return; // Usuário cancelou
                }
                
                if (resultadoGaveta && !resultadoGaveta.sucesso && resultadoGaveta.continuarVenda) {
                    console.log('⚠️ Continuando venda sem abrir gaveta (escolha do usuário)');
                }
                
                // 2. REGISTRAR VENDA
                const dadosPagamento = {
                    valor_recebido: valorRecebido,
                    troco: troco
                };
                
                const resultado = await registrarVenda('DINHEIRO', dadosPagamento);
                
                if (!resultado || !resultado.sucesso) {
                    alert('❌ Erro ao registrar venda no sistema.');
                    return;
                }
                
                // 3. LIMPAR CARRINHO AUTOMATICAMENTE (SEM CONFIRMAÇÃO)
                limparCarrinho(true);
                
                // 4. MOSTRAR TROCO
                if (troco > 0) {
                    alert(`✅ VENDA REALIZADA COM SUCESSO!\n\n💵 Valor Recebido: R$ ${valorRecebido.toFixed(2)}\n💰 Troco: R$ ${troco.toFixed(2)}\n\n✅ Carrinho limpo automaticamente`);
                } else {
                    alert(`✅ VENDA REALIZADA COM SUCESSO!\n\n💵 Valor Recebido: R$ ${valorRecebido.toFixed(2)}\n✅ Sem troco\n\n✅ Carrinho limpo automaticamente`);
                }
                
            } catch (error) {
                console.error('Erro ao processar DINHEIRO:', error);
                alert('❌ Erro ao processar pagamento em dinheiro:\n\n' + error.message);
            }
        }

