<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>OMG - Faça seu Pedido</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --roxo: #6c059b;
            --roxo-escuro: #4a0470;
            --roxo-claro: #8b2fc9;
            --roxo-bg: #f3e8ff;
            --creme: #f5f0e8;
            --creme-escuro: #ede5d4;
            --branco: #ffffff;
            --verde: #22c55e;
            --verde-escuro: #16a34a;
            --amarelo: #f59e0b;
            --vermelho: #ef4444;
            --texto: #1a0a2e;
            --texto-muted: #6b7280;
            --sombra: 0 8px 32px rgba(108,5,155,0.18);
            --sombra-card: 0 4px 16px rgba(0,0,0,0.10);
            --radius: 16px;
            --radius-sm: 10px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { font-family: 'Nunito', sans-serif; background: #1a0a2e; display: flex; align-items: center; justify-content: center; min-height: 100vh; overflow: hidden; }
        .totem-wrapper { width: 100vw; height: 100vh; display: flex; flex-direction: column; background: var(--creme); overflow: hidden; position: relative; }
        .totem-header { background: linear-gradient(135deg, var(--roxo) 0%, var(--roxo-escuro) 100%); padding: 18px 30px 22px; display: flex; align-items: center; gap: 18px; position: relative; flex-shrink: 0; }
        .header-logo { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; }
        .header-logo img { width: 48px; height: 48px; object-fit: contain; border-radius: 8px; }
        .header-title { font-family: 'Baloo 2', cursive; font-size: 42px; font-weight: 800; color: white; letter-spacing: 2px; text-transform: uppercase; text-shadow: 0 2px 8px rgba(0,0,0,0.25); line-height: 1; }
        .header-wave { position: absolute; bottom: -1px; left: 0; right: 0; height: 20px; overflow: hidden; }
        .header-wave svg { width: 100%; height: 100%; }
        .totem-body { display: flex; flex: 1; overflow: hidden; padding-bottom: 90px; }
        .sidebar-cats { width: 190px; background: linear-gradient(180deg, var(--roxo-escuro) 0%, #2d0450 100%); display: flex; flex-direction: column; padding: 20px 14px; gap: 12px; flex-shrink: 0; }
        .cat-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 16px 10px; background: rgba(255,255,255,0.12); border: 2px solid transparent; border-radius: var(--radius-sm); cursor: pointer; transition: all 0.2s; color: rgba(255,255,255,0.75); font-family: 'Nunito', sans-serif; font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; min-height: 80px; }
        .cat-btn .cat-icon { font-size: 26px; line-height: 1; }
        .cat-btn:hover { background: rgba(255,255,255,0.2); color: white; border-color: rgba(255,255,255,0.3); transform: translateX(4px); }
        .cat-btn.active { background: white; color: var(--roxo); border-color: white; box-shadow: 0 4px 16px rgba(0,0,0,0.25); transform: translateX(6px); }
        .produtos-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .categoria-titulo { font-family: 'Baloo 2', cursive; font-size: 28px; font-weight: 800; color: var(--roxo); padding: 16px 24px 8px; text-transform: uppercase; letter-spacing: 1px; flex-shrink: 0; }
        .produtos-scroll { flex: 1; overflow-y: auto; padding: 8px 20px 20px; scrollbar-width: thin; scrollbar-color: var(--roxo-claro) transparent; }
        .produtos-scroll::-webkit-scrollbar { width: 6px; }
        .produtos-scroll::-webkit-scrollbar-thumb { background: var(--roxo-claro); border-radius: 3px; }
        .produtos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .produto-card { background: white; border-radius: var(--radius); overflow: hidden; box-shadow: var(--sombra-card); border: 2px solid transparent; transition: all 0.2s; display: flex; flex-direction: column; cursor: pointer; }
        .produto-card:hover { border-color: var(--roxo-claro); transform: translateY(-3px); box-shadow: 0 8px 24px rgba(108,5,155,0.18); }
        .produto-card:active { transform: scale(0.97); }
        .produto-img-wrapper { height: 150px; background: var(--creme); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
        .produto-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
        .produto-img-placeholder { font-size: 64px; opacity: 0.25; position: absolute; }
        .produto-info { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
        .produto-nome-card { font-size: 16px; font-weight: 800; color: var(--texto); line-height: 1.2; text-align: center; }
        .produto-preco-card { font-size: 20px; font-weight: 900; color: var(--roxo); text-align: center; font-family: 'Baloo 2', cursive; }
        .btn-adicionar-card { margin-top: 4px; padding: 10px; background: var(--roxo); color: white; border: none; border-radius: var(--radius-sm); font-family: 'Nunito', sans-serif; font-size: 14px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; transition: all 0.2s; width: 100%; }
        .btn-adicionar-card:hover { background: var(--roxo-escuro); transform: translateY(-1px); }
        .btn-adicionar-card.added { background: var(--verde); animation: pulse-green 0.4s ease; }
        @keyframes pulse-green { 0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1); } }
        .loading-state { grid-column: span 2; padding: 60px 20px; text-align: center; color: var(--roxo); }
        .spinner { width: 48px; height: 48px; border: 5px solid var(--roxo-bg); border-top-color: var(--roxo); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .totem-footer { background: white; border-top: 3px solid var(--creme-escuro); padding: 16px 20px; display: flex; gap: 16px; align-items: center; flex-shrink: 0; position: fixed; bottom: 0; left: 0; right: 0; z-index: 999; box-shadow: 0 -4px 16px rgba(108,5,155,0.12); }
        .btn-confirmar { flex: 1; padding: 18px 30px; background: var(--roxo); color: white; border: none; border-radius: var(--radius-sm); font-family: 'Baloo 2', cursive; font-size: 22px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: all 0.2s; box-shadow: var(--sombra); }
        .btn-confirmar:hover { background: var(--roxo-escuro); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(108,5,155,0.35); }
        .btn-confirmar:disabled { background: var(--creme-escuro); color: var(--texto-muted); cursor: not-allowed; box-shadow: none; transform: none; }
        .carrinho-total-pill { display: flex; align-items: center; gap: 12px; background: var(--creme); border: 2px solid var(--creme-escuro); border-radius: var(--radius-sm); padding: 14px 20px; min-width: 160px; }
        .carrinho-icone { font-size: 28px; position: relative; }
        .carrinho-badge { position: absolute; top: -8px; right: -10px; background: var(--roxo); color: white; font-size: 11px; font-weight: 800; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .carrinho-valor { font-family: 'Baloo 2', cursive; font-size: 24px; font-weight: 800; color: var(--texto); }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(26,10,46,0.75); z-index: 1000; align-items: flex-end; justify-content: center; }
        .modal-overlay.active { display: flex; }
        .modal-sheet { background: white; border-radius: 24px 24px 0 0; width: 100%; max-height: 85vh; display: flex; flex-direction: column; animation: slideUp 0.3s ease; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .modal-header { background: linear-gradient(135deg, var(--roxo) 0%, var(--roxo-escuro) 100%); padding: 20px 24px; border-radius: 24px 24px 0 0; display: flex; justify-content: space-between; align-items: center; }
        .modal-title { font-family: 'Baloo 2', cursive; font-size: 24px; font-weight: 800; color: white; letter-spacing: 1px; }
        .btn-fechar-modal { background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.4); color: white; width: 40px; height: 40px; border-radius: 50%; font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .btn-fechar-modal:hover { background: rgba(255,255,255,0.35); }
        .modal-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
        .carrinho-item { display: flex; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--creme-escuro); }
        .carrinho-item:last-child { border-bottom: none; }
        .item-info { flex: 1; }
        .item-nome-cart { font-size: 17px; font-weight: 800; color: var(--texto); }
        .item-preco-unit { font-size: 14px; color: var(--texto-muted); font-weight: 600; }
        .item-subtotal { font-family: 'Baloo 2', cursive; font-size: 20px; font-weight: 800; color: var(--roxo); }
        .qtd-ctrl { display: flex; align-items: center; gap: 12px; background: var(--creme); border-radius: 10px; padding: 6px 10px; }
        .qtd-ctrl button { width: 32px; height: 32px; border: 2px solid var(--roxo); background: white; border-radius: 8px; font-size: 18px; font-weight: 800; color: var(--roxo); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
        .qtd-ctrl button:hover { background: var(--roxo); color: white; }
        .qtd-ctrl span { font-size: 18px; font-weight: 800; color: var(--texto); min-width: 28px; text-align: center; }
        .modal-footer { padding: 20px 24px; border-top: 2px solid var(--creme-escuro); background: var(--creme); }
        .total-linha { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .total-label { font-size: 20px; font-weight: 800; color: var(--texto); }
        .total-valor-modal { font-family: 'Baloo 2', cursive; font-size: 32px; font-weight: 800; color: var(--roxo); }
        .pagamento-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .btn-pgto { padding: 16px; border: none; border-radius: var(--radius-sm); color: white; font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .btn-pgto:hover { transform: translateY(-2px); filter: brightness(1.1); }
        .btn-pgto:active { transform: scale(0.97); }
        .btn-pgto-pix { background: #10b981; grid-column: span 2; font-size: 18px; padding: 18px; }
        .btn-pgto-credito { background: var(--roxo); }
        .btn-pgto-debito { background: var(--amarelo); }
        .btn-pgto-dividido { background: linear-gradient(135deg, var(--roxo) 0%, var(--amarelo) 100%); grid-column: span 2; }
        .modal-pagamento { display: none; position: fixed; inset: 0; background: rgba(26,10,46,0.85); z-index: 2000; align-items: center; justify-content: center; }
        .modal-pagamento.active { display: flex; }
        .pagamento-sheet { background: white; border-radius: 24px; width: 90%; max-width: 500px; overflow: hidden; animation: popIn 0.3s ease; }
        @keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .pgto-header { background: linear-gradient(135deg, var(--roxo), var(--roxo-escuro)); padding: 24px 28px; text-align: center; }
        .pgto-header-icon { font-size: 48px; margin-bottom: 8px; }
        .pgto-header h2 { font-family: 'Baloo 2', cursive; font-size: 26px; font-weight: 800; color: white; letter-spacing: 1px; }
        .pgto-header p { color: rgba(255,255,255,0.8); font-size: 16px; margin-top: 6px; }
        .pgto-body { padding: 28px; }
        .pgto-total { text-align: center; background: var(--roxo-bg); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 24px; }
        .pgto-total-label { font-size: 14px; color: var(--texto-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
        .pgto-total-valor { font-family: 'Baloo 2', cursive; font-size: 40px; font-weight: 800; color: var(--roxo); }
        .pgto-status { text-align: center; padding: 20px; background: var(--creme); border-radius: var(--radius-sm); margin-bottom: 20px; }
        .pgto-status p { font-size: 16px; font-weight: 700; color: var(--texto); }
        .pgto-actions { display: flex; gap: 12px; }
        .btn-pgto-cancelar { flex: 1; padding: 14px; background: var(--creme-escuro); border: none; border-radius: var(--radius-sm); color: var(--texto-muted); font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 800; cursor: pointer; transition: all 0.2s; }
        .btn-pgto-cancelar:hover { background: var(--vermelho); color: white; }
        .modal-dividido-sheet { background: white; border-radius: 24px; width: 90%; max-width: 520px; max-height: 90vh; overflow-y: auto; animation: popIn 0.3s ease; }
        .dividido-item { background: var(--creme); border: 2px solid var(--creme-escuro); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 12px; }
        .dividido-item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .dividido-numero { font-weight: 800; color: var(--roxo); font-size: 16px; }
        .btn-rm-dividido { background: var(--vermelho); color: white; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; }
        .dividido-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-group label { display: block; font-size: 12px; font-weight: 800; color: var(--texto-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
        .form-group select, .form-group input { width: 100%; padding: 10px 12px; border: 2px solid var(--creme-escuro); border-radius: 8px; font-family: 'Nunito', sans-serif; font-size: 15px; font-weight: 700; color: var(--texto); background: white; outline: none; transition: border-color 0.2s; }
        .form-group select:focus, .form-group input:focus { border-color: var(--roxo); }
        .resumo-dividido-box { background: var(--roxo-bg); border: 2px solid var(--roxo); border-radius: var(--radius-sm); padding: 16px; margin: 16px 0; }
        .resumo-linha { display: flex; justify-content: space-between; padding: 6px 0; font-size: 15px; font-weight: 700; }
        .resumo-linha.total { border-top: 2px solid var(--roxo); margin-top: 8px; padding-top: 12px; font-size: 17px; font-weight: 900; color: var(--roxo); }
        .faltante { color: var(--vermelho); font-weight: 900; }
        .ok { color: var(--verde); font-weight: 900; }
        .modal-sucesso { display: none; position: fixed; inset: 0; background: rgba(26,10,46,0.9); z-index: 3000; align-items: center; justify-content: center; }
        .modal-sucesso.active { display: flex; }
        .sucesso-sheet { background: white; border-radius: 24px; width: 85%; max-width: 440px; padding: 48px 36px; text-align: center; animation: popIn 0.4s ease; }
        .sucesso-icone { font-size: 80px; margin-bottom: 16px; animation: bounceIn 0.6s ease 0.1s both; }
        @keyframes bounceIn { 0% { transform: scale(0); } 60% { transform: scale(1.15); } 100% { transform: scale(1); } }
        .sucesso-titulo { font-family: 'Baloo 2', cursive; font-size: 30px; font-weight: 800; color: var(--roxo); margin-bottom: 8px; }
        .sucesso-sub { font-size: 16px; color: var(--texto-muted); font-weight: 600; margin-bottom: 28px; }
        .sucesso-codigo { background: var(--roxo-bg); border-radius: 12px; padding: 16px; margin-bottom: 28px; }
        .sucesso-codigo-label { font-size: 13px; font-weight: 800; color: var(--texto-muted); text-transform: uppercase; letter-spacing: 1px; }
        .sucesso-codigo-valor { font-family: 'Baloo 2', cursive; font-size: 36px; font-weight: 800; color: var(--roxo); }
        .btn-novo-pedido { width: 100%; padding: 18px; background: var(--roxo); color: white; border: none; border-radius: var(--radius-sm); font-family: 'Baloo 2', cursive; font-size: 22px; font-weight: 800; letter-spacing: 1.5px; cursor: pointer; transition: all 0.2s; }
        .btn-novo-pedido:hover { background: var(--roxo-escuro); transform: translateY(-2px); }
        #telaLogin { display: none; position: fixed; inset: 0; background: linear-gradient(135deg, var(--roxo) 0%, var(--roxo-escuro) 100%); z-index: 9999; align-items: center; justify-content: center; }
        #telaLogin.active { display: flex; }
        .login-box { background: white; border-radius: 24px; padding: 48px 40px; width: 90%; max-width: 400px; text-align: center; }
        .login-logo { font-size: 64px; margin-bottom: 16px; }
        .login-titulo { font-family: 'Baloo 2', cursive; font-size: 28px; font-weight: 800; color: var(--roxo); margin-bottom: 8px; }
        .login-sub { color: var(--texto-muted); font-size: 15px; font-weight: 600; margin-bottom: 28px; }
        .login-input { width: 100%; padding: 14px 18px; border: 2px solid var(--creme-escuro); border-radius: var(--radius-sm); font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 700; color: var(--texto); margin-bottom: 12px; outline: none; transition: border-color 0.2s; }
        .login-input:focus { border-color: var(--roxo); }
        .btn-login { width: 100%; padding: 16px; background: var(--roxo); color: white; border: none; border-radius: var(--radius-sm); font-family: 'Baloo 2', cursive; font-size: 20px; font-weight: 800; cursor: pointer; transition: all 0.2s; margin-top: 8px; }
        .btn-login:hover { background: var(--roxo-escuro); }
        .login-erro { color: var(--vermelho); font-size: 14px; font-weight: 700; margin-top: 10px; display: none; }
        .empty-carrinho { text-align: center; padding: 40px 20px; color: var(--texto-muted); }
        .empty-carrinho-icon { font-size: 56px; opacity: 0.25; margin-bottom: 12px; }
        .empty-carrinho p { font-size: 16px; font-weight: 700; }
        .toast { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--roxo); color: white; padding: 14px 28px; border-radius: 50px; font-size: 16px; font-weight: 800; z-index: 9000; opacity: 0; transition: all 0.3s; pointer-events: none; white-space: nowrap; }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        #telaBoasVindas { display: none; position: fixed; inset: 0; z-index: 500; background: linear-gradient(160deg, #1a0a2e 0%, #3b0764 50%, #1a0a2e 100%); flex-direction: column; align-items: center; justify-content: space-between; overflow: hidden; cursor: pointer; }
        #telaBoasVindas.active { display: flex; }
        .bv-particles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
        .bv-particle { position: absolute; border-radius: 50%; background: rgba(180, 80, 255, 0.15); animation: floatParticle linear infinite; }
        @keyframes floatParticle { 0% { transform: translateY(110vh) scale(0.5); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translateY(-20vh) scale(1.2); opacity: 0; } }
        .bv-topo { width: 100%; display: flex; flex-direction: column; align-items: center; padding-top: 44px; position: relative; z-index: 2; }
        .bv-logo-ring { width: 130px; height: 130px; }
        .bv-logo-ring img { width: 126px; height: 126px; object-fit: contain; border-radius: 12px; }
        .bv-bemvindo { font-family: 'Nunito', sans-serif; font-size: 16px; font-weight: 700; color: rgba(255,255,255,0.55); letter-spacing: 4px; text-transform: uppercase; margin-bottom: 6px; }
        .bv-nome-loja { font-family: 'Baloo 2', cursive; font-size: 42px; font-weight: 800; color: #fff; text-align: center; line-height: 1.1; text-shadow: 0 4px 24px rgba(180,80,255,0.55); padding: 0 20px; margin-bottom: 8px; }
        .bv-subtitulo { font-family: 'Nunito', sans-serif; font-size: 18px; font-weight: 600; color: rgba(255,255,255,0.6); }
        .bv-divider { width: 80px; height: 4px; background: linear-gradient(90deg, var(--roxo-claro), #f59e0b); border-radius: 2px; margin: 14px auto 0; }
        .bv-cats-titulo { font-family: 'Baloo 2', cursive; font-size: 18px; font-weight: 800; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 3px; text-align: center; position: relative; z-index: 2; }
        .bv-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; padding: 0 20px 16px; width: 100%; max-width: 820px; position: relative; z-index: 2; }
        .bv-cat-card { border-radius: 18px; overflow: hidden; cursor: pointer; position: relative; aspect-ratio: 1 / 1; border: 2px solid rgba(255,255,255,0.08); transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 8px 28px rgba(0,0,0,0.5); background: #2d0450; }
        .bv-cat-card:hover { transform: scale(1.04) translateY(-4px); box-shadow: 0 16px 48px rgba(140,50,255,0.5); border-color: rgba(180,80,255,0.5); }
        .bv-cat-card:active { transform: scale(0.96); }
        .bv-cat-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
        .bv-cat-card:hover .bv-cat-img { transform: scale(1.08); }
        .bv-cat-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0) 30%, rgba(26,10,46,0.92) 100%); }
        .bv-cat-emoji { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 68px; }
        .bv-cat-nome { position: absolute; bottom: 0; left: 0; right: 0; padding: 12px 8px; font-family: 'Baloo 2', cursive; font-size: 19px; font-weight: 800; color: white; text-align: center; text-transform: uppercase; text-shadow: 0 2px 8px rgba(0,0,0,0.7); letter-spacing: 0.5px; }
